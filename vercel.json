{
  "headers": [
    { "source": "/vendor/wasm/(.*).wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }, { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" }] }
  ]
}
